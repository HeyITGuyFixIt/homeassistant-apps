:{{ .listen_port }} {
    # Cloudflare Access integration
    {{ if .cf_access_enabled }}
    @cloudflare {
        header cf_access_jwt_assertion -
    }
    
    respond @cloudflare "Unauthorized" 401 {
        header www-authenticate "Bearer realm=\"Cloudflare Access\""
    }
    
    # Cloudflare Access validates at the edge, we just forward
    # The edge sets CF-Access-Client-Id and CF-Access-Client-Secret
    # If you want to enforce at the app level, add:
    # reverse_proxy :{{ .node_port }} {
    #     header_up CF-Access-Client-Id {cf_access_client_id}
    #     header_up CF-Access-Client-Secret {cf_access_client_secret}
    # }
    {{ end }}
    
    # Pangolin/Newt integration
    {{ if .pangolin_enabled }}
    # Pangolin adds X-Pangolin-Verified header if auth passed
    @pangolin {
        header X-Pangolin-Verified -
    }
    
    respond @pangolin "Unauthorized" 401 {
        header www-authenticate "Bearer realm=\"Pangolin\""
    }
    {{ end }}
    
    # OIDC integration (optional, requires Caddy OIDC module)
    {{ if .oidc_enabled }}
    oidc {
        provider {{ .oidc_provider }}
        client_id {{ .oidc_client_id }}
        client_secret {{ .oidc_client_secret }}
        redirect_uri {{ .oidc_redirect_url }}
    }
    
    # Only allow authenticated users
    @authenticated {
        oidc authenticated
    }
    
    respond @authenticated "Unauthorized" 401
    {{ end }}
    
    # Main reverse proxy
    reverse_proxy :{{ .node_port }} {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        # WebSocket support
        transport websocket {
            upgrade $http_upgrade
            connection $connection
        }
        
        # Long-lived connections for River/Delta/Git
        flush_interval -1
        buf_size -1
    }
}