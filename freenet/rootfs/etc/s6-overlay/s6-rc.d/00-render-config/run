#!/usr/bin/with-contenv bash
set -euo pipefail

# These are CONSTANTS and must match the keys in config.yaml ports:.
# The user changes the HOST side in the app's Network section; the
# container side is fixed, so Caddy can bind it unconditionally.
readonly NODE_API_PORT=7509
readonly NETWORK_PORT=31337
readonly GATEWAY_PORT=8443

OPTS="/data/options.json"
fail() { echo "freenet-render: $*" >&2; exit 1; }

STORAGE=$(jq -r '.storage_mb' "${OPTS}")
OPENNET=$(jq -r '.opennet' "${OPTS}")
AUTH_MODE=$(jq -r '.auth_mode' "${OPTS}")
# CF_TEAM=$(jq -r '.cf_team_domain // empty' "${OPTS}")
OIDC_ISSUER=$(jq -r '.oidc_issuer // empty' "${OPTS}")
OIDC_CLIENT=$(jq -r '.oidc_client_id // empty' "${OPTS}")
OIDC_SECRET=$(jq -r '.oidc_client_secret // empty' "${OPTS}")
DISABLE_UPDATE=$(jq -r '.disable_auto_update' "${OPTS}")
LOG_LEVEL=$(jq -r '.log_level' "${OPTS}")

options=$(bashio::addon.options)
old_keys=("cf_team_domain", "cf_aud_tag", "oidc_redirect_url", "")
for old_key in "${old_keys[@]}"; do
  if bashio::jq.exists "${options}" ".${old_key}"; then
      bashio::log.info "Removing ${old_key}"
      bashio::addon.option "${old_key}"
  fi
done

# [ "${AUTH_MODE}" != "cloudflare_access" ] || [ -n "${CF_TEAM}" ] \
#   || fail "auth_mode=cloudflare_access requires cf_team_domain"

if [ "${AUTH_MODE}" = "oidc" ]; then
  [ -n "${OIDC_ISSUER}" ] && [ -n "${OIDC_CLIENT}" ] && [ -n "${OIDC_SECRET}" ] \
    || fail "auth_mode=oidc requires oidc_issuer, oidc_client_id and oidc_client_secret"
fi

# --- Node environment -------------------------------------------------------
# Upstream's entrypoint reads these, and passes --config-dir / --data-dir
# to the node explicitly. Do not try to write a TOML file; the entrypoint
# owns that.
#
# The API must bind a non-loopback address under bridge networking, because
# 127.0.0.1 inside the container is the container's own loopback and the
# published port cannot forward to it. Caddy then proxies to 127.0.0.1, so
# the API stays reachable only from inside this container.
export FREENET_WS_API_ADDRESS="::"
export WS_API_PORT="${NODE_API_PORT}"
export NETWORK_PORT="${NETWORK_PORT}"
export RUST_LOG="${LOG_LEVEL}"
export FREENET_DISABLE_AUTO_UPDATE=""
[ "${DISABLE_UPDATE}" = "true" ] && export FREENET_DISABLE_AUTO_UPDATE=1

# Persist for the longrun scripts, which run in a separate process.
mkdir -p /data/env
printf '%s' "${FREENET_WS_API_ADDRESS}" > /data/env/FREENET_WS_API_ADDRESS
printf '%s' "${WS_API_PORT}"            > /data/env/WS_API_PORT
printf '%s' "${NETWORK_PORT}"           > /data/env/NETWORK_PORT
printf '%s' "${RUST_LOG}"               > /data/env/RUST_LOG
printf '%s' "${FREENET_DISABLE_AUTO_UPDATE}" > /data/env/FREENET_DISABLE_AUTO_UPDATE

# --- Caddyfile --------------------------------------------------------------
mkdir -p /etc/caddy
{
  echo "# Generated by the Freenet Home Assistant app. Do not edit by hand."
  echo "# auth_mode = ${AUTH_MODE}"
  echo ""
  echo ":${GATEWAY_PORT} {"
  echo "  encode zstd gzip"
  echo ""

  case "${AUTH_MODE}" in
    cloudflare_access)
      cat <<EOF
  # Cloudflare Access authenticates at the edge. We only check that the
  # assertion header is PRESENT, not that its signature is valid, so the
  # Access policy is what actually authenticates. Leave the hostname
  # without a policy and this app is public.
  @noaccess {
    not header Cf-Access-Jwt-Assertion *
  }
  respond @noaccess "Unauthorized: missing Cloudflare Access assertion" 401
EOF
      ;;
    pangolin)
      echo "  # Pangolin authenticates at its server before Newt forwards."
      echo "  # No per-request token reaches us, so the trust boundary is"
      echo "  # that only Newt can reach this port."
      ;;
    oidc)
      cat <<EOF
  security {
    oidc_internal_provider freenet {
      issuer_url ${OIDC_ISSUER}
      client_id ${OIDC_CLIENT}
      client_secret ${OIDC_SECRET}
    }
  }
  authenticate with freenet
EOF
      ;;
    none)
      echo "  # WARNING: auth_mode=none. No authentication at this layer."
      ;;
  esac

  cat <<EOF

  # The node validates the Host header. Without this it rejects requests
  # arriving via a tunnel hostname.
  reverse_proxy 127.0.0.1:${NODE_API_PORT} {
    header_up Host 127.0.0.1:${NODE_API_PORT}
    flush_interval -1
    transport http {
      keepalive 30s
      read_timeout 0
    }
  }
}
EOF
} > /etc/caddy/Caddyfile

echo "freenet-render: node API :::${NODE_API_PORT}, gateway :${GATEWAY_PORT}, auth=${AUTH_MODE}"